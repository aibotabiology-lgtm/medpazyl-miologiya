{
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
    {"source": "/data/(.*)\\.json", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
    {"source": "/data/img/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
  ]
}
